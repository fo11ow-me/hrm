# Copy this file to .env and replace placeholders
# 部署相关
SERVER_HOST=<服务器IP>
SERVER_USER=root
REGISTRY_USER=REPLACE_WITH_REGISTRY_USER
REGISTRY_PASSWORD=REPLACE_WITH_REGISTRY_PASSWORD

# Docker 端口绑定
BACKEND_BIND_PORT=18888
FRONTEND_BIND_PORT=18080
EXTERNAL_DOCKER_NETWORK=REPLACE_WITH_EXTERNAL_DOCKER_NETWORK

# 数据库配置
DB_MASTER_URL=jdbc:mysql://REPLACE_WITH_DB_HOST:3306/hrm
DB_FLOWABLE_URL=jdbc:mysql://REPLACE_WITH_DB_HOST:3306/hrm_flowable
DB_USERNAME=REPLACE_WITH_DB_USERNAME
DB_PASSWORD=REPLACE_WITH_DB_PASSWORD

# Redis 配置
REDIS_HOST=REPLACE_WITH_REDIS_HOST
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_WITH_REDIS_PASSWORD
REDIS_DATABASE=0

# JWT 密钥
JWT_SECRET=REPLACE_WITH_BASE64_JWT_SECRET

# OSS 对象存储
OSS_ENDPOINT=REPLACE_WITH_OSS_ENDPOINT
OSS_ACCESS_KEY_ID=REPLACE_WITH_OSS_ACCESS_KEY_ID
OSS_ACCESS_KEY_SECRET=REPLACE_WITH_OSS_ACCESS_KEY_SECRET
OSS_BUCKET_NAME=REPLACE_WITH_OSS_BUCKET_NAME

# Flowable 工作流
FLOWABLE_SCHEMA_UPDATE=true

# MyBatis 日志
MYBATIS_LOG_IMPL=org.apache.ibatis.logging.nologging.NoLoggingImpl

# AI 助手（可选）
ASSISTANT_ENABLED=false
ASSISTANT_PROVIDER_BASE_URL=https://REPLACE_WITH_ASSISTANT_PROVIDER_HOST
ASSISTANT_PROVIDER_API_KEY=REPLACE_WITH_ASSISTANT_PROVIDER_API_KEY
ASSISTANT_PROVIDER_MODEL=REPLACE_WITH_ASSISTANT_PROVIDER_MODEL
